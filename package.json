{
  "name": "bap-ka-rasta",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-based Indian street-driving game built with React, TypeScript, and Three.js. Explore Mumbai-inspired roads in an auto rickshaw with keyboard or touch controls.",
  "license": "UNLICENSED",
  "homepage": "https://bap-ka-rasta.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tirthankardgen-cell/Bap-Ka-Rasta.git"
  },
  "bugs": {
    "url": "https://github.com/tirthankardgen-cell/Bap-Ka-Rasta/issues"
  },
  "keywords": [
    "browser-game",
    "driving-game",
    "indie-game",
    "mumbai",
    "india",
    "react",
    "typescript",
    "threejs",
    "vite",
    "webgl",
    "web-audio",
    "single-player"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "assets:characters:pack": "node scripts/characters/pack_mumbai_characters.mjs",
    "voices:generate": "node --env-file=.env.local scripts/voices/generate.mjs",
    "voices:catalogue": "node --experimental-strip-types scripts/voices/build.mjs",
    "voices:verify": "node --experimental-strip-types scripts/voices/verify.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "meshoptimizer": "^1.1.1",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}
